// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────
// Academic Models
// ──────────────────────────────────────

enum ClassStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

/// Academic Year session (e.g. 2025-2026)
model AcademicYear {
  id        String   @id @default(cuid())
  name      String   @unique // e.g. "2025-2026"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  classes     Class[]
  enrollments Enrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isCurrent])
  @@map("academic_years")
}

/// Teacher / Staff member
model Teacher {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  phone     String?
  isActive  Boolean  @default(true)

  classes   ClassTeacher[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("teachers")
}

/// A class/course in the madrasa (e.g. Class 8, Hifz Year 2)
model Class {
  id             String      @id @default(cuid())
  name           String                  // e.g. "Class 8", "Hifz Year 1"
  section        String?                 // e.g. "A", "B"
  code           String      @unique     // e.g. "CLS-08A"
  teacher        String?                 // legacy teacher name string (for backwards compatibility)
  capacity       Int         @default(40)
  status         ClassStatus @default(ACTIVE)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  archivedAt     DateTime?

  // Relations
  students    Student[]
  exams       Exam[]
  attendances Attendance[]
  enrollments Enrollment[]
  teachers    ClassTeacher[]
  subjects    ClassSubject[]

  @@index([academicYearId])
  @@index([status])
  @@index([name])
  @@map("classes")
}

/// Teacher assignment to class
model ClassTeacher {
  id        String    @id @default(cuid())
  classId   String
  teacherId String
  role      String?   // "Main Teacher", "Assistant", "Quran Teacher"
  startDate DateTime?
  endDate   DateTime?

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, teacherId])
  @@index([classId])
  @@index([teacherId])
  @@map("class_teachers")
}

/// Subject definition
model Subject {
  id          String  @id @default(cuid())
  name        String
  code        String  @unique
  description String?
  isActive    Boolean @default(true)

  classes ClassSubject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("subjects")
}

/// Subject assigned to class
model ClassSubject {
  id             String @id @default(cuid())
  classId        String
  subjectId      String
  periodsPerWeek Int?

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, subjectId])
  @@index([classId])
  @@index([subjectId])
  @@map("class_subjects")
}

/// Student enrollment record
enum EnrollmentStatus {
  ACTIVE
  TRANSFERRED
  WITHDRAWN
  COMPLETED
}

model Enrollment {
  id             String           @id @default(cuid())
  studentId      String
  classId        String
  academicYearId String
  enrollmentDate DateTime         @default(now())
  exitDate       DateTime?
  rollNumber     String?
  status         EnrollmentStatus @default(ACTIVE)

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([classId])
  @@index([academicYearId])
  @@index([classId, status])
  @@map("enrollments")
}

/// Audit log for system compliance
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  oldValue  Json?
  newValue  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// A student enrolled in the madrasa
model Student {
  id            String   @id @default(cuid())
  admissionNo   String   @unique    // e.g. "AK-2024-001"
  firstName     String
  lastName      String
  fatherName    String?
  motherName    String?
  email         String?
  phone         String?
  dateOfBirth   DateTime?
  gender        Gender   @default(MALE)
  address       String?
  admissionDate DateTime @default(now())
  status        StudentStatus @default(ACTIVE)

  // Guardian info
  guardianName     String?
  guardianPhone    String?
  guardianEmail    String?
  guardianRelation String?  // "Father", "Uncle", "Brother", etc.

  // Additional info
  bloodGroup       String?
  nationality      String?  @default("Indian")
  idNumber         String?  // Aadhaar or any govt ID
  previousSchool   String?
  emergencyContact String?
  medicalNotes     String?
  photoUrl         String?

  // Foreign keys
  classId       String?
  class         Class?   @relation(fields: [classId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  attendances      Attendance[]
  results          Result[]
  customFieldValues CustomFieldValue[]
  enrollments      Enrollment[]

  @@map("students")
}

/// Daily attendance record
model Attendance {
  id        String           @id @default(cuid())
  date      DateTime
  status    AttendanceStatus @default(PRESENT)
  remarks   String?

  // Foreign keys
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([studentId, date])  // One record per student per day
  @@map("attendances")
}

/// An examination
model Exam {
  id        String   @id @default(cuid())
  title     String           // e.g. "Mid-Term 2024"
  subject   String?          // e.g. "Mathematics"
  date      DateTime
  totalMarks Int     @default(100)

  // Foreign keys
  classId   String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  results   Result[]

  @@map("exams")
}

/// Exam result for a student
model Result {
  id           String @id @default(cuid())
  marksObtained Float
  grade         String?
  remarks       String?

  // Foreign keys
  examId    String
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([examId, studentId])  // One result per student per exam
  @@map("results")
}

// ──────────────────────────────────────
// Dynamic Custom Fields
// ──────────────────────────────────────

/// Admin-defined custom field definition
model CustomField {
  id          String    @id @default(cuid())
  name        String             // "Blood Group", "Aadhaar Number"
  fieldKey    String    @unique   // "blood_group", "aadhaar_number" (auto-slug)
  fieldType   FieldType           // TEXT, NUMBER, DATE, SELECT, CHECKBOX, TEXTAREA
  options     String?             // JSON array for SELECT: '["A+","A-","B+","O+"]'
  placeholder String?             // Placeholder text
  isRequired  Boolean   @default(false)
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)  // Display order
  section     String    @default("custom") // "personal", "contact", "academic", "custom"
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  values      CustomFieldValue[]

  @@map("custom_fields")
}

/// Stores the actual value of a custom field for a specific student
model CustomFieldValue {
  id            String @id @default(cuid())
  value         String           // Stored as string, interpreted by fieldType

  customFieldId String
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([customFieldId, studentId])  // One value per field per student
  @@map("custom_field_values")
}

// ──────────────────────────────────────
// Enums
// ──────────────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  EXPELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum FieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  CHECKBOX
  TEXTAREA
}
